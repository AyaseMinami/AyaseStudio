# Shared fallback credential. Protocol-specific keys below take precedence.
AYASE_RELAY_API_KEY=

# Base URLs stop before the protocol resource path.
# Example: https://relay.example.com/v1 -> SDK appends /chat/completions or /responses.
AYASE_OPENAI_CHAT_BASE_URL=
AYASE_OPENAI_CHAT_API_KEY=
AYASE_OPENAI_CHAT_MODEL=

AYASE_OPENAI_RESPONSES_BASE_URL=
AYASE_OPENAI_RESPONSES_API_KEY=
AYASE_OPENAI_RESPONSES_MODEL=

# Example: https://relay.example.com -> app appends /v1beta/models/{model}:streamGenerateContent.
AYASE_GEMINI_BASE_URL=https://api.relayrouter.ai
AYASE_GEMINI_API_KEY=
AYASE_GEMINI_MODEL=gemini-3.8-flash

# Example: https://relay.example.com -> app appends /v1/messages.
AYASE_ANTHROPIC_BASE_URL=
AYASE_ANTHROPIC_API_KEY=
AYASE_ANTHROPIC_MODEL=
